{{! Description: Main view of the application }}
  <div class="flex justify-center items-center h-screen bg-gray-200">
    <div class="bg-white p-8 rounded shadow-md w-96">
      <h1 class="text-3xl font-bold mb-4">User Admin Panel</h1>
      <p class="text-gray-700 text-sm font-bold mb-2">Name: {{user.first_name}}</p>
      <p class="text-gray-700 text-sm font-bold mb-2">Last Name: {{user.last_name}}</p>
      <p class="text-gray-700 text-sm font-bold mb-2">Email: {{user.email}}</p>
      <form action="/api/sessions/logout" method="POST" class="flex" >
        <button class="bg-blue-500 text-white p-2 rounded mr-2 text-center">
        <p class="block text-center">Logout</p>
      </button>
      </form>
    </div>
  </div>






